# Optional: if unset, backend falls back to an in-memory store (resets on restart).
# Matches the docker-compose.yml service. Host port is 5433 to avoid clashes with
# a locally-installed Postgres on 5432.
DATABASE_URL=postgres://parkscan:parkscan@localhost:5433/parkscan

# Google Maps Platform (server-side key; restrict by IP in prod)
GOOGLE_MAPS_API_KEY=your_key_here

# URL Puppeteer loads when rendering a report PDF. Only override for non-default
# frontend deployments.
# FRONTEND_URL=http://localhost:5173

# PORT=3001
