# ────────────────────────────────────────────────────────────────────────────
# ParkScan backend — environment template.
# Copy to .env and fill in values. Nothing here is committed.
# ────────────────────────────────────────────────────────────────────────────

# ── Storage ─────────────────────────────────────────────────────────────────
# If unset, backend falls back to an in-memory store (resets on restart).
# Matches the docker-compose.yml service. Host port is 5433 to avoid clashes
# with a locally-installed Postgres on 5432.
DATABASE_URL=postgres://parkscan:parkscan@localhost:5433/parkscan

# ── Google Maps Platform (single key) ───────────────────────────────────────
# One server-side key is enough for all Maps/Street View/Places endpoints.
# Restrict it by IP in production.
GOOGLE_MAPS_API_KEY=your_key_here

# ── Google Maps Platform (optional per-API splits) ──────────────────────────
# Each of these, if set, takes precedence over GOOGLE_MAPS_API_KEY for that
# specific API. Useful when you want tighter restrictions or separate billing.
# GOOGLE_MAPS_STATIC_API_KEY=
# GOOGLE_STREET_VIEW_STATIC_API_KEY=
# GOOGLE_GEOCODING_API_KEY=
# GOOGLE_PLACES_API_KEY=
# GOOGLE_DISTANCE_MATRIX_API_KEY=
# GOOGLE_ROADS_API_KEY=
# GOOGLE_ADDRESS_VALIDATION_API_KEY=

# ── LLM: outreach drafting (pick ONE) ───────────────────────────────────────
# Option A (cheapest): Gemini API key.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Option B: Vertex AI via service account.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json
# GOOGLE_PROJECT_ID=
# GOOGLE_LOCATION=us-central1

# ── Cloud Vision: frontage analysis ─────────────────────────────────────────
# Uses GOOGLE_APPLICATION_CREDENTIALS if set (service account path), else the
# dedicated API key.
# GOOGLE_VISION_API_KEY=

# ── BAG Individuele Bevragingen (paid, for gebruiksdoel/oppervlakte/bouwjaar)
# Without this, sites get real addresses from PDOK Locatieserver (free) and
# synthesized use/area/buildyear. With it, those fields come from the real
# BAG registry.
# BAG_API_KEY=

# ── App config ──────────────────────────────────────────────────────────────
# URL Puppeteer loads when rendering a report PDF. Only override for non-default
# frontend deployments.
# Outreach automation defaults to a demo-safe internal inbox workflow.
# OUTREACH_AUTOMATION_ENABLED=true
# OUTREACH_MIN_VACANCY_SCORE=65
# OUTREACH_MAX_SITES_PER_SCAN=5
# OUTREACH_DELIVERY_MODE=internal_inbox
# OUTREACH_TEST_TO=
# OUTREACH_FROM_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# FRONTEND_URL=http://localhost:5173
# PORT=3001
